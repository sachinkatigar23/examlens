# For docker compose (the whole stack). Copy to .env and replace the three secrets.
# Generate a value with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SERVICE_KEY=change-me-shared-by-server-and-ai-service

# Optional
# CHAT_MODEL=qwen2.5:3b
# EMBED_MODEL=nomic-embed-text
# DEMO_EMAIL=demo@examlens.local
# DEMO_PASSWORD=examlens-demo
# DEMO_DIR=demo-data            # folder the demo seed uploads (samples = your own gitignored PDFs)

# --- Production / public demo (docker-compose.prod.yml, see docs/DEPLOY.md) ---
# DOMAIN=examlens.example.com   # Caddy gets the HTTPS certificate for it; its DNS A record must point here
# PUBLIC_DEMO=true              # sign-ups closed, demo account read-only (the prod compose defaults to true)
# DEMO_CLOUD_PER_IP=5           # Cloud answers per visitor IP per day (on top of the Gemini daily quota)
# DEMO_ASK_PER_IP=30            # answers of any kind per visitor IP per day (also max 5 per 5 minutes)
# DEMO_MAX_CONCURRENT=2         # answers generated at once; more visitors are asked to try again in a minute
# SEED_MODE=local               # model the demo seed pre-writes answers with (cloud = faster, uses the quota)
