# For docker compose (the whole stack). Copy to .env and replace the three secrets.
# Generate a value with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SERVICE_KEY=change-me-shared-by-server-and-ai-service

# Optional
# CHAT_MODEL=qwen2.5:3b
# EMBED_MODEL=nomic-embed-text
# DEMO_EMAIL=demo@examlens.local
# DEMO_PASSWORD=examlens-demo
